APP_NAME=AI Speaker Notes MVP
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
STORAGE_DIR=storage/jobs
MAX_UPLOAD_MB=50
MAX_ZIP_ENTRIES=10000
MAX_UNCOMPRESSED_MB=500
JOB_RETENTION_HOURS=24
MAX_CONCURRENT_JOBS=2

# Vision rendering. auto = PowerPoint on Windows when available, otherwise LibreOffice.
SLIDE_RENDERER=auto
LIBREOFFICE_BIN=auto
RENDER_DPI=120

# OpenAI is opt-in. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
# Enables the Vision feature. Each job still chooses Text-only or Vision in the UI.
OPENAI_USE_VISION=true
OPENAI_IMAGE_DETAIL=auto
OPENAI_BATCH_SIZE=4
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2
OPENAI_SEMANTIC_RETRIES=2
OPENAI_RESUME_CHECKPOINTS=true
OPENAI_VISION_FALLBACK_TO_TEXT=true
POWERPOINT_RENDER_TIMEOUT_SECONDS=120
OPENAI_MAX_ESTIMATED_JOB_COST_USD=1.00
OPENAI_VISION_ESTIMATED_INPUT_TOKENS_PER_SLIDE=1100

# Estimated cost display only; update these when provider pricing changes.
OPENAI_INPUT_USD_PER_MTOK=0.20
OPENAI_OUTPUT_USD_PER_MTOK=1.20
