APP_NAME=AI Speaker Notes
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
STORAGE_DIR=storage/jobs
MAX_UPLOAD_MB=50
MAX_ZIP_ENTRIES=10000
MAX_UNCOMPRESSED_MB=500
ALLOW_EMBEDDED_OBJECTS=false
JOB_RETENTION_HOURS=24
MAX_CONCURRENT_JOBS=2

# Optional single-account login. Recommended for every public deployment.
AUTH_ENABLED=false
AUTH_USERNAME=admin
AUTH_PASSWORD=
# Required when AUTH_ENABLED=true. Use a random value >=32 characters; never commit the real value.
SESSION_SECRET=
SESSION_HOURS=8
# Optional separate source DB for admin presentation/chat activity.
APPLICATION_DATABASE_URL=
TERMS_VERSION=2026-09-13
REQUIRE_TERMS_ACCEPTANCE=true

# OIDC / Keycloak (used when AUTH_PROVIDER=keycloak).
AUTH_PROVIDER=local
PUBLIC_BASE_URL=http://127.0.0.1:8000
USER_APP_URL=https://aispeakernote.lensalingkungantech.com
KEYCLOAK_ISSUER=
KEYCLOAK_INTERNAL_ISSUER=
KEYCLOAK_CLIENT_ID=ai-speaker-notes
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_CLOCK_SKEW_SECONDS=60
KEYCLOAK_ADMIN_LOGIN_CLIENT_ID=ai-speaker-admin-login
KEYCLOAK_ADMIN_LOGIN_CLIENT_SECRET=CHANGE_ME_FROM_KEYCLOAK_ADMIN_LOGIN_CLIENT

# Optional extra demo/API access header protection.
DEMO_ACCESS_KEY=

# Rendering. auto = Microsoft PowerPoint on Windows when available, otherwise LibreOffice.
SLIDE_RENDERER=auto
LIBREOFFICE_BIN=auto
RENDER_DPI=120
POWERPOINT_RENDER_TIMEOUT_SECONDS=120

# OpenAI. v0.2.8 defaults to GPT-5.6 Sol for quality, with hard input/cost limits.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_USE_VISION=true
OPENAI_IMAGE_DETAIL=auto
OPENAI_BATCH_SIZE=4
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2
OPENAI_SEMANTIC_RETRIES=2
OPENAI_RESUME_CHECKPOINTS=true
OPENAI_VISION_FALLBACK_TO_TEXT=true

# Per-job guardrails.
OPENAI_MAX_SOURCE_CHARS_PER_JOB=180000
OPENAI_MAX_ESTIMATED_JOB_COST_USD=1.00
OPENAI_VISION_ESTIMATED_INPUT_TOKENS_PER_SLIDE=1100

# File-aware Chat AI guardrails.
OPENAI_CHAT_MODEL=gpt-5.6-sol
OPENAI_CHAT_REASONING_EFFORT=medium
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_MAX_TURNS_PER_JOB=20
CHAT_MAX_CONTEXT_SLIDES=12
CHAT_MAX_HISTORY_MESSAGES=10
CHAT_MAX_OUTPUT_TOKENS=1400

# Cost estimate only. Update when provider pricing changes.
OPENAI_INPUT_USD_PER_MTOK=4.00
OPENAI_OUTPUT_USD_PER_MTOK=20.00

# Keycloak admin dashboard
KEYCLOAK_ADMIN_CLIENT_ID=ai-speaker-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ADMIN_API_BASE_URL=
ADMIN_ROLE=admin
