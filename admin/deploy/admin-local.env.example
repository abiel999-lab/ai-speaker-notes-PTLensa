# Local application URL.
APP_NAME=AI Speaker Notes
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001
PUBLIC_BASE_URL=http://127.0.0.1:8001
USER_APP_URL=https://aispeakernote.lensalingkungantech.com
FRONTEND_ORIGINS=http://127.0.0.1:8001,http://localhost:8001

# Local PostgreSQL started by docker-compose.admin-local.yml.
DATABASE_URL=postgresql+psycopg://aispeaker:${ADMIN_DB_PASSWORD}@127.0.0.1:5434/aispeaker
# Optional read-only/source DB for real AI Speaker Notes jobs/chat. Leave blank until the SSH tunnel is ready.
APPLICATION_DATABASE_URL=
STORAGE_DIR=storage/jobs
JOB_RETENTION_HOURS=168
MAX_UPLOAD_MB=50

# Authentication uses the existing remote Keycloak realm.
AUTH_ENABLED=true
AUTH_PROVIDER=keycloak
SESSION_SECRET=CHANGE_ME_AT_LEAST_48_RANDOM_CHARACTERS
SESSION_HOURS=8
REQUIRE_TERMS_ACCEPTANCE=false
KEYCLOAK_ISSUER=https://identity-iot.lensalingkungantech.com/realms/aispeaker
KEYCLOAK_CLIENT_ID=ai-speaker-notes
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_FROM_KEYCLOAK_CLIENT_CREDENTIALS
KEYCLOAK_CLOCK_SKEW_SECONDS=60
KEYCLOAK_ADMIN_LOGIN_CLIENT_ID=ai-speaker-admin-login
KEYCLOAK_ADMIN_LOGIN_CLIENT_SECRET=CHANGE_ME_FROM_KEYCLOAK_ADMIN_LOGIN_CLIENT

ADMIN_ROLE=admin

# Separate Keycloak service-account client. Do not expose this secret in browser code.
KEYCLOAK_ADMIN_CLIENT_ID=ai-speaker-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME_FROM_KEYCLOAK_ADMIN_SERVICE_ACCOUNT
KEYCLOAK_ADMIN_API_BASE_URL=

# Keep AI optional while testing login/admin.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_CHAT_MODEL=gpt-5.6-sol
OPENAI_USE_VISION=false
SLIDE_RENDERER=auto
