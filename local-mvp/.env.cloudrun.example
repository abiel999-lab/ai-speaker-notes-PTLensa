APP_NAME=AI Speaker Notes
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8080
FRONTEND_ORIGINS=https://YOUR-DOMAIN.example
STORAGE_DIR=/tmp/ai-speaker-notes/jobs
MAX_UPLOAD_MB=50
MAX_ZIP_ENTRIES=10000
MAX_UNCOMPRESSED_MB=500
ALLOW_EMBEDDED_OBJECTS=false
JOB_RETENTION_HOURS=24
MAX_CONCURRENT_JOBS=2
MAX_ACTIVE_JOBS_PER_USER=2

# Public deployment: enable login and supply secrets via Secret Manager / environment.
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=
SESSION_SECRET=
SESSION_HOURS=8
TERMS_VERSION=2026-09-13
REQUIRE_TERMS_ACCEPTANCE=true

SLIDE_RENDERER=libreoffice
LIBREOFFICE_BIN=auto
RENDER_DPI=120
POWERPOINT_RENDER_TIMEOUT_SECONDS=120

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_USE_VISION=true
OPENAI_IMAGE_DETAIL=auto
OPENAI_BATCH_SIZE=4
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2
OPENAI_SEMANTIC_RETRIES=2
OPENAI_RESUME_CHECKPOINTS=true
OPENAI_VISION_FALLBACK_TO_TEXT=true
OPENAI_MAX_SLIDES_PER_JOB=80
OPENAI_MAX_VISION_SLIDES_PER_JOB=60
OPENAI_MAX_SOURCE_CHARS_PER_JOB=180000
OPENAI_MAX_ESTIMATED_JOB_COST_USD=1.00
OPENAI_VISION_ESTIMATED_INPUT_TOKENS_PER_SLIDE=1100
OPENAI_CHAT_MODEL=gpt-5.6-sol
OPENAI_CHAT_REASONING_EFFORT=medium
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_MAX_TURNS_PER_JOB=20
CHAT_MAX_CONTEXT_SLIDES=12
CHAT_MAX_HISTORY_MESSAGES=10
CHAT_MAX_OUTPUT_TOKENS=1400
OPENAI_INPUT_USD_PER_MTOK=4.00
OPENAI_OUTPUT_USD_PER_MTOK=20.00
