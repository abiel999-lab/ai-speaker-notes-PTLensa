# Copy to .env.prod and replace every CHANGE_ME value.
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_LONG_RANDOM_POSTGRES_PASSWORD
APP_DB_PASSWORD=CHANGE_ME_LONG_RANDOM_APP_DB_PASSWORD
KEYCLOAK_DB_PASSWORD=CHANGE_ME_LONG_RANDOM_KEYCLOAK_DB_PASSWORD
KEYCLOAK_ADMIN_USERNAME=kcadmin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_KEYCLOAK_ADMIN_PASSWORD
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_LONG_RANDOM_OIDC_CLIENT_SECRET
APP_SESSION_SECRET=CHANGE_ME_AT_LEAST_48_RANDOM_CHARACTERS
OPENAI_API_KEY=CHANGE_ME

# NotePreso Free/Pro Phase 1. A value of 0 means unlimited.
FREE_MONTHLY_PRESENTATIONS=3
FREE_MONTHLY_CHAT_MESSAGES=20
FREE_VISION_ENABLED=false
PRO_MONTHLY_PRESENTATIONS=50
PRO_MONTHLY_CHAT_MESSAGES=500
PRO_VISION_ENABLED=true

# Billing provider. Activate one provider at a time while testing.
# Entitlements remain internal and provider-independent.
PAYMENT_PROVIDER=disabled

# Xendit one-time Pro (example values; keep secrets outside source control).
XENDIT_PRO_PRICE_IDR=50000
XENDIT_CHECKOUT_MODE=one_time
XENDIT_PRO_ACCESS_DAYS=30

# Stripe one-time Pro (example values; keep secrets outside source control).
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_PRO_PRICE_IDR=50000
STRIPE_PRO_ACCESS_DAYS=30
STRIPE_TIMEOUT_SECONDS=20
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
