{
  "name": "verbatim-presentation-studio",
  "version": "1.0.0-dev.9h",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env server-dist/server/index.js",
    "worker": "node --env-file-if-exists=.env server-dist/server/worker.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "sample": "node --import tsx scripts/sample.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "bullmq": "6.3.14",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.7",
    "ioredis": "5.8.2",
    "jszip": "3.10.2",
    "lucide-react": "1.56.0",
    "openid-client": "6.8.8",
    "opentype.js": "2.0.0",
    "pg": "8.23.1",
    "pptxgenjs": "4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/opentype.js": "1.3.10",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "overrides": {
    "image-size": "2.0.3"
  }
}
